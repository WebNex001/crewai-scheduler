{"name": "crewai-scheduler", "version": "3.2.0", "description": "CrewAI多智能体团队调度系统 v3.2 - 工作流流水线（需求→架构→设计→开发→审查→测试→部署→交付）、模块化开发、断点续传、暂停/恢复、Token追踪、API限流重试", "author": "OpenClaw", "entry": "__main__.py", "commands": [{"name": "init", "description": "初始化调度系统", "args": []}, {"name": "create-project", "description": "创建新项目（自动初始化工作流状态）", "args": [{"name": "--name", "required": true, "description": "项目名称"}, {"name": "--description", "required": false, "description": "项目描述"}, {"name": "--department", "required": false, "description": "部门（技术部/运营部/交付部）", "default": "技术部"}]}, {"name": "list-projects", "description": "列出所有项目", "args": []}, {"name": "status", "description": "查看系统状态", "args": []}, {"name": "report", "description": "生成执行报告", "args": [{"name": "--project", "required": false, "description": "指定项目"}]}, {"name": "monitor", "description": "查看使用监控报告", "args": []}, {"name": "clear", "description": "清空所有数据", "args": [{"name": "--confirm", "required": false, "description": "确认清空"}]}, {"name": "execute-workflow", "description": "[v3.2] 执行项目工作流（8阶段流水线+模块化开发+断点续传）", "args": [{"name": "--project", "required": false, "description": "项目名称"}, {"name": "--all", "required": false, "description": "执行所有待处理项目"}, {"name": "--stage", "required": false, "description": "从指定阶段开始(1-8)"}, {"name": "--dry-run", "required": false, "description": "干跑模式：预览不调API"}, {"name": "--resume", "required": false, "description": "断点续传：自动恢复中断的工作流"}]}, {"name": "workflow-status", "description": "[v3.2] 查看项目工作流进度", "args": [{"name": "--project", "required": false, "description": "项目名称"}]}, {"name": "workflow-reset", "description": "[v3.2] 重置项目工作流", "args": [{"name": "--project", "required": true, "description": "项目名称"}]}, {"name": "workflow-stages", "description": "[v3.2] 查看部门工作流定义", "args": [{"name": "--department", "required": false, "description": "部门名称", "default": "技术部"}]}, {"name": "workflow-health", "description": "[v3.2] 健康检查：扫描崩溃/中断的工作流", "args": [{"name": "--fix", "required": false, "description": "自动修复崩溃状态"}, {"name": "--resume", "required": false, "description": "自动恢复中断的工作流"}]}, {"name": "workflow-pause", "description": "[v3.2] 暂停正在执行的工作流", "args": [{"name": "--project", "required": true, "description": "项目名称"}]}, {"name": "workflow-resume", "description": "[v3.2] 恢复暂停的工作流", "args": [{"name": "--project", "required": true, "description": "项目名称"}]}], "dependencies": {"python": ">=3.8", "packages": ["openai>=1.0.0"]}, "config": {"api_key": "env:OPENAI_API_KEY or config.json:api.openai_api_key", "base_url": "config.json:api.base_url", "model": "config.json:api.model", "debug": "config.json:system.debug", "timeout": "config.json:api.timeout", "max_retries": "config.json:workflow.{dept}.max_retries", "thinking": "config.json:workflow.{dept}.stages[].thinking"}, "openclaw": {"enabled": true, "callable": true}}